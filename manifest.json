{
  "manifest_version": 3,
  "name": "Cowl - Secure Messaging Privacy",
  "version": "1.2.0",
  "description": "Blurs messages, names, profile photos and media on WhatsApp Web and Telegram Web until you hover.",
  "default_locale": "en",
  "browser_specific_settings": {
    "gecko": {
      "id": "cowl@cowl-extension",
      "strict_min_version": "112.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://web.whatsapp.com/*",
    "*://web.telegram.org/*"
  ],
  "background": {
    "scripts": ["background/background.js"]
  },
  "content_scripts": [
    {
      "matches": ["*://web.whatsapp.com/*", "*://web.telegram.org/*"],
      "js": ["content/blur.js"],
      "css": ["assets/css/injected-blur.css"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
